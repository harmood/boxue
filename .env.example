# Database（本机原生实例与 Docker 统一使用宿主端口 5433）
POSTGRES_DB=boxue
POSTGRES_USER=boxue
POSTGRES_PASSWORD=boxue_dev_pwd
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# S3 兼容对象存储（本机与 Docker 均使用 RustFS）
S3_ACCESS_KEY=boxue_dev
S3_SECRET_KEY=boxue_dev_secret_change_me
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=boxue-media
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ENDPOINT=http://127.0.0.1:9000
S3_MAX_SIZE_MB=10
S3_MAX_REQUEST_MB=12

# Backend
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/boxue
SPRING_DATASOURCE_USERNAME=boxue
SPRING_DATASOURCE_PASSWORD=boxue_dev_pwd
BOXUE_ADMIN_USERNAME=admin
BOXUE_ADMIN_PASSWORD=admin

# Bootstrap admin (one-time CLI; leave blank in version control)
BOXUE_BOOTSTRAP_ADMIN_EMAIL=
BOXUE_BOOTSTRAP_ADMIN_USERNAME=admin
BOXUE_BOOTSTRAP_ADMIN_PASSWORD=
BOXUE_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
JWT_ISSUER=boxue
JWT_CLIENT_SECRET=dev-client-secret-change-me-32-bytes
JWT_ADMIN_SECRET=dev-admin-secret-change-me-32-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
BOXUE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
BOXUE_AUTH_LOG_DEV_LINKS=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_PER_IP=30
AUTH_LOGIN_PER_ACCOUNT=10
AUTH_ADMIN_LOGIN_PER_IP=10
AUTH_ADMIN_LOGIN_PER_ACCOUNT=5
BOXUE_WEB_BASE_URL=http://localhost:5173

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@boxue.local

# AI (disabled in phase 1)
BOXUE_AI_ENABLED=false
