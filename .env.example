# Database（本机原生实例与 Docker 统一使用宿主端口 5433）
POSTGRES_DB=boxue
POSTGRES_USER=boxue
POSTGRES_PASSWORD=boxue_dev_pwd
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# S3 兼容对象存储（本机与 Docker 均使用 RustFS）
S3_ACCESS_KEY=boxue_dev
S3_SECRET_KEY=boxue_dev_secret_change_me
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=boxue-media
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ENDPOINT=http://127.0.0.1:9000

# Backend
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/boxue
SPRING_DATASOURCE_USERNAME=boxue
SPRING_DATASOURCE_PASSWORD=boxue_dev_pwd
BOXUE_ADMIN_USERNAME=admin
BOXUE_ADMIN_PASSWORD=admin
JWT_ISSUER=boxue
JWT_CLIENT_SECRET=change-me-client
JWT_ADMIN_SECRET=change-me-admin
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@boxue.local

# AI (disabled in phase 1)
BOXUE_AI_ENABLED=false
