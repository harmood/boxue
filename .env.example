# Database
POSTGRES_DB=boxue
POSTGRES_USER=boxue
POSTGRES_PASSWORD=boxue_dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=boxue
MINIO_ROOT_PASSWORD=boxue_dev_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/boxue
SPRING_DATASOURCE_USERNAME=boxue
SPRING_DATASOURCE_PASSWORD=boxue_dev_password
JWT_ISSUER=boxue
JWT_CLIENT_SECRET=change-me-client
JWT_ADMIN_SECRET=change-me-admin
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@boxue.local

# AI (disabled in phase 1)
BOXUE_AI_ENABLED=false